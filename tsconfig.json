{
  "compilerOptions": {
    "strict": true,
    "types": ["bun", "bun-types"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "rewriteRelativeImportExtensions": true,
    "lib": ["ESNext"],
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*", "types/**/*"]
}